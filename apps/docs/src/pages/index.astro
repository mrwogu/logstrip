---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
// Raw HTML on purpose: Markdown would split the <pre> code windows on blank
// lines and turn quotes into smart quotes.
import home from '../components/home.html?raw';
import pkg from '../../../../package.json';
import benchmarks from '../data/benchmarks.json';
import '../styles/home.css';
import type { BenchmarkDocument } from '../benchmarks';
import { proofHtml } from '../benchmarks';
import { faqHtml, homeFaq } from '../faq';
import { ECOSYSTEM_PILLS, marqueeHtml } from '../home-marquee';
import { homeValues, renderHome } from '../home';
import { pipelineHtml } from '../home-pipeline';
import { faqJsonLd, homeJsonLd } from '../seo';
import { BASE, SITE_DESCRIPTION } from '../site.mjs';

// The numbers on this page come from data/benchmarks.json (npm run docs:bench),
// the same file that fills docs/benchmarks.md.
const doc = benchmarks as BenchmarkDocument;
const faq = homeFaq(doc.totals);
const jest = doc.fixtures.find((row) => row.id === 'jest-noisy');

const html = renderHome(home, {
  base: BASE,
  values: homeValues(doc),
  blocks: {
    marquee: marqueeHtml(ECOSYSTEM_PILLS),
    proof: proofHtml(doc),
    pipeline: pipelineHtml({
      inputLines: jest?.inputLines ?? 0,
      outputLines: jest?.outputLines ?? 0,
    }),
    faq: faqHtml(faq),
  },
});
---

<StarlightPage
  frontmatter={{
    title: 'Log Compression CLI for AI Agents',
    description: `${SITE_DESCRIPTION} Install with npm.`,
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
    lastUpdated: false,
    head: [
      { tag: 'meta', attrs: { property: 'og:type', content: 'website' } },
      homeJsonLd(pkg.version),
      faqJsonLd(faq),
    ],
  }}
>
  <Fragment set:html={html} />
  <script>
    import { initHeroDemo } from '../scripts/home-demo';
    import { initCopyButtons } from '../scripts/home-copy';
    initHeroDemo(import.meta.env.BASE_URL);
    initCopyButtons();
  </script>
</StarlightPage>
