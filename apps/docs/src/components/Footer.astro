---
import Default from '@astrojs/starlight/components/Footer.astro';
import { NPM, REPO } from '../site.mjs';
---

<Default />
<div class="ls-footer">
  <p>
    Copyright &copy; 2026 <a href="https://github.com/mrwogu" rel="author">mrwogu</a>{' - '}Released
    under the <a href={`${REPO}/blob/main/LICENSE`}>MIT License</a>
  </p>
  <p class="ls-footer__links">
    <a href={REPO}>GitHub</a>
    <a href={NPM}>npm</a>
    <a href={`${REPO}/blob/main/CHANGELOG.md`}>Changelog</a>
  </p>
</div>

<style>
  .ls-footer {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .ls-footer p {
    margin: 0.35rem 0;
  }
  .ls-footer a {
    color: var(--sl-color-gray-2);
  }
  .ls-footer a:hover {
    color: var(--sl-color-accent-high);
  }
  .ls-footer__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 1.25rem;
  }
</style>
